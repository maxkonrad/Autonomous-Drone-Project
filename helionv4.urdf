<?xml version="1.0" ?>
<robot name="helion_v4_pro">
  
  <material name="carbon_fiber">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="motor_metal">
    <color rgba="0.6 0.1 0.1 1.0"/> </material>

  <link name="base_link">
    <inertial>
      <mass value="1.846"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.1"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.22 0.08 0.05"/></geometry>
      <material name="carbon_fiber"/>
    </visual>
    
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0.6"/> <geometry><box size="0.418 0.02 0.015"/></geometry>
      <material name="carbon_fiber"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -0.6"/> 
      <geometry><box size="0.418 0.02 0.015"/></geometry>
      <material name="carbon_fiber"/>
    </visual>

    <visual>
      <origin xyz="0.16 0.11 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
      <material name="motor_metal"/>
    </visual>
    <visual>
      <origin xyz="0.16 -0.11 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
      <material name="motor_metal"/>
    </visual>
    <visual>
      <origin xyz="-0.16 0.11 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
      <material name="motor_metal"/>
    </visual>
    <visual>
      <origin xyz="-0.16 -0.11 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
      <material name="motor_metal"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.324 0.264 0.063"/></geometry>
    </collision>
  </link>
</robot>
